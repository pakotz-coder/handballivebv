# Copiaza acest fisier ca ".env" pentru rularea locala (npm run dev). Fisierul .env nu se urca pe GitHub.
# Pe Netlify, aceleasi variabile se pun la Site configuration -> Environment variables.

# Parola panoului de administrare (minimum 8 caractere)
ADMIN_PASSWORD=

# Adresa de e-mail afisata pe pagina "Pentru cluburi si parinti" (optional)
CONTACT_EMAIL=

# Doar pentru lucru local cu sursa simulata (npm run mock):
# SOURCE_BASE_URL=http://localhost:8899/coman
# YOUTUBE_FEED_BASE_URL=http://localhost:8899/feeds/videos.xml
# YOUTUBE_OEMBED_URL=http://localhost:8899/oembed
